{
  "description": "Java application (Maven quickstart, JUnit)",
  "requires": [
    [
      "mvn"
    ],
    [
      "java"
    ]
  ],
  "scaffold": [
    {
      "run": [
        "mvn",
        "-B",
        "archetype:generate",
        "-DarchetypeGroupId=org.apache.maven.archetypes",
        "-DarchetypeArtifactId=maven-archetype-quickstart",
        "-DarchetypeVersion=1.5",
        "-DgroupId=com.example",
        "-DartifactId={{name}}",
        "-Dversion=0.1.0-SNAPSHOT",
        "-DinteractiveMode=false"
      ],
      "cwd": "stage",
      "hoist": "{{name}}"
    }
  ],
  "commands": {
    "test": "mvn -B test",
    "build": "mvn -B package",
    "lint": "mvn -B verify -DskipTests"
  },
  "no_tests": {
    "patterns": [
      "No tests to run",
      "There are no tests to run",
      "Tests run: 0,"
    ],
    "unless": [
      "Tests run: [1-9]"
    ],
    "exit_codes": []
  },
  "gitignore": [
    "src/target/"
  ],
  "generated": [
    "target"
  ],
  "ci": {
    "steps": [
      {
        "uses": "actions/setup-java@v6",
        "with": {
          "distribution": "temurin",
          "java-version": "21"
        }
      }
    ]
  },
  "test_names": {
    "language": "Java",
    "rule": {
      "all": [
        {
          "kind": "method_declaration"
        },
        {
          "has": {
            "kind": "modifiers",
            "has": {
              "regex": "^@([\\w.]+\\.)?(Test|ParameterizedTest|RepeatedTest)\\b"
            }
          }
        },
        {
          "has": {
            "field": "name",
            "pattern": "$NAME"
          }
        }
      ]
    },
    "name_regex": "."
  }
}
